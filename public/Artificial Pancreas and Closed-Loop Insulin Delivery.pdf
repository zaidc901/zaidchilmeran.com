    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Artificial Pancreas and Closed-Loop Insulin Delivery: From Early Concepts to AI-Driven Diabetes Automation</rdf:li>
     <rdf:li xml:lang="en-US">Artificial Pancreas and Closed-Loop Insulin Delivery: From Early Concepts to AI-Driven Diabetes Automation</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>[-15]artificial pancreas; closed-loop insulin delivery; automated insulin delivery; continuous glucose monitoring; model predictive control; diabetes technology; machine learning</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:type>
    <rdf:Bag>
     <rdf:li>Text</rdf:li>
    </rdf:Bag>
   </dc:type>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Closed-loop insulin delivery</rdf:li>
     <rdf:li xml:lang="en-US">Closed-loop insulin delivery</rdf:li>
     <rdf:li xml:lang="x-default">or the artificial pancreas</rdf:li>
     <rdf:li xml:lang="en-US">or the artificial pancreas</rdf:li>
     <rdf:li xml:lang="x-default">has evolved from an ambitious engineering concept into one of the most consequential advances in diabetes technology. By integrating continuous glucose monitoring</rdf:li>
     <rdf:li xml:lang="en-US">has evolved from an ambitious engineering concept into one of the most consequential advances in diabetes technology. By integrating continuous glucose monitoring</rdf:li>
     <rdf:li xml:lang="x-default">insulin pumps</rdf:li>
     <rdf:li xml:lang="en-US">insulin pumps</rdf:li>
     <rdf:li xml:lang="x-default">and control algorithms into a single feedback system</rdf:li>
     <rdf:li xml:lang="en-US">and control algorithms into a single feedback system</rdf:li>
     <rdf:li xml:lang="x-default">these platforms aim to shift diabetes care from repeated manual correction toward more anticipatory and adaptive glucose regulation. The field has progressed from early proof-of-concept systems to contemporary hybrid closed-loop platforms</rdf:li>
     <rdf:li xml:lang="en-US">these platforms aim to shift diabetes care from repeated manual correction toward more anticipatory and adaptive glucose regulation. The field has progressed from early proof-of-concept systems to contemporary hybrid closed-loop platforms</rdf:li>
     <rdf:li xml:lang="x-default">reflecting a deeper shift in diabetes management itself: from treating glucose excursions after they occur to trying to blunt them in real time. Its clinical relevance is greatest in type 1 diabetes</rdf:li>
     <rdf:li xml:lang="en-US">reflecting a deeper shift in diabetes management itself: from treating glucose excursions after they occur to trying to blunt them in real time. Its clinical relevance is greatest in type 1 diabetes</rdf:li>
     <rdf:li xml:lang="x-default">where the burden of self-management is high and the consequences of glycemic instability are immediate. This review introduces the major technologies and evidence shaping the field</rdf:li>
     <rdf:li xml:lang="en-US">where the burden of self-management is high and the consequences of glycemic instability are immediate. This review introduces the major technologies and evidence shaping the field</rdf:li>
     <rdf:li xml:lang="x-default">with emphasis on the control strategies that drive system behavior</rdf:li>
     <rdf:li xml:lang="en-US">with emphasis on the control strategies that drive system behavior</rdf:li>
     <rdf:li xml:lang="x-default">and asks which currently available closed-loop systems offer the best balance of glycemic benefit</rdf:li>
     <rdf:li xml:lang="en-US">and asks which currently available closed-loop systems offer the best balance of glycemic benefit</rdf:li>
     <rdf:li xml:lang="x-default">usability</rdf:li>
     <rdf:li xml:lang="en-US">usability</rdf:li>
     <rdf:li xml:lang="x-default">and translational readiness for routine diabetes care. Across randomized trials and real-world studies</rdf:li>
     <rdf:li xml:lang="en-US">and translational readiness for routine diabetes care. Across randomized trials and real-world studies</rdf:li>
     <rdf:li xml:lang="x-default">automated insulin delivery has consistently improved time in range</rdf:li>
     <rdf:li xml:lang="en-US">automated insulin delivery has consistently improved time in range</rdf:li>
     <rdf:li xml:lang="x-default">reduced hypoglycemia</rdf:li>
     <rdf:li xml:lang="en-US">reduced hypoglycemia</rdf:li>
     <rdf:li xml:lang="x-default">and enhanced patient experience</rdf:li>
     <rdf:li xml:lang="en-US">and enhanced patient experience</rdf:li>
     <rdf:li xml:lang="x-default">particularly in pediatric populations. At the same time</rdf:li>
     <rdf:li xml:lang="en-US">particularly in pediatric populations. At the same time</rdf:li>
     <rdf:li xml:lang="x-default">important limitations remain: sensor lag</rdf:li>
     <rdf:li xml:lang="en-US">important limitations remain: sensor lag</rdf:li>
     <rdf:li xml:lang="x-default">the physiologic constraints of subcutaneous insulin</rdf:li>
     <rdf:li xml:lang="en-US">the physiologic constraints of subcutaneous insulin</rdf:li>
     <rdf:li xml:lang="x-default">device complexity</rdf:li>
     <rdf:li xml:lang="en-US">device complexity</rdf:li>
     <rdf:li xml:lang="x-default">cost</rdf:li>
     <rdf:li xml:lang="en-US">cost</rdf:li>
     <rdf:li xml:lang="x-default">and unequal access limit full autonomy and widespread adoption. Looking ahead</rdf:li>
     <rdf:li xml:lang="en-US">and unequal access limit full autonomy and widespread adoption. Looking ahead</rdf:li>
     <rdf:li xml:lang="x-default">the next phase of progress will likely depend on more adaptive artificial intelligence</rdf:li>
     <rdf:li xml:lang="en-US">the next phase of progress will likely depend on more adaptive artificial intelligence</rdf:li>
     <rdf:li xml:lang="x-default">improved meal detection</rdf:li>
     <rdf:li xml:lang="en-US">improved meal detection</rdf:li>
     <rdf:li xml:lang="x-default">multimodal wearable data</rdf:li>
     <rdf:li xml:lang="en-US">multimodal wearable data</rdf:li>
     <rdf:li xml:lang="x-default">and multi-hormone systems that move the field closer to truly physiologic glucose control.</rdf:li>
     <rdf:li xml:lang="en-US">and multi-hormone systems that move the field closer to truly physiologic glucose control.</rdf:li>
    </rdf:Alt>
   </dc:description>
